{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "()": "pythonjsonlogger.jsonlogger.JsonFormatter",
      "format": "%(asctime)s %(name)s %(levelname)s %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "json",
      "stream": "ext://sys.stdout"
    },
    "arquivo": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "json",
      "filename": "process_json.log",
      "maxBytes": 5000000,
      "backupCount": 5
    },
    "erros": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "ERROR",
      "formatter": "json",
      "filename": "errors_json.log",
      "maxBytes": 2000000,
      "backupCount": 3
    }
  },
  "loggers": {
    "Merge & Filter Pipeline": {
      "handlers": ["console", "arquivo", "erros"],
      "level": "DEBUG",
      "propagate": false
    }
  }
}
